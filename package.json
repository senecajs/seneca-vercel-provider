{
  "name": "@seneca/vercel-provider",
  "version": "0.2.0",
  "main": "dist/vercel-provider.js",
  "type": "commonjs",
  "types": "dist/vercel-provider.d.ts",
  "description": "Seneca entity provider for the Vercel API.",
  "homepage": "https://github.com/senecajs/seneca-vercel-provider",
  "keywords": [
    "seneca",
    "vercel",
    "vercel-provider"
  ],
  "author": "Richard Rodger - richardrodger.com",
  "contributors": [
    "José Perigolo Neto (https://github.com/Jose-Perigolo)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senecajs/seneca-vercel-provider.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "jest --coverage",
    "test-some": "jest -t",
    "test-watch": "jest --coverage --watchAll",
    "watch": "tsc -w -d",
    "build": "tsc -d",
    "prepack": "npm run build",
    "doc": "echo seneca-doc -p @seneca/provider FIX-broken",
    "clean": "rm -rf node_modules dist yarn.lock package-lock.json",
    "reset": "npm run clean && npm i && npm run build && npm test",
    "repo-tag": "REPO_VERSION=`node -e \"console.log(require('./package').version)\"` && echo TAG: v$REPO_VERSION && git commit -a -m v$REPO_VERSION && git push && git tag v$REPO_VERSION && git push --tags;",
    "repo-publish": "npm run clean && npm i && npm run repo-publish-quick",
    "repo-publish-quick": "npm run build && npm run test && npm run doc && npm run repo-tag && npm publish --access public --registry https://registry.npmjs.org "
  },
  "license": "MIT",
  "files": [
    "dist",
    "src/**/*.ts",
    "LICENSE",
    "CHANGES.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@seneca/entity": "^29.0.0",
    "@seneca/env": "^0.6.0",
    "@seneca/provider": "^5.0.0",
    "seneca": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@seneca/env": {
      "optional": true
    }
  },
  "devDependencies": {
    "@seneca/entity": "^29.0.0",
    "@seneca/env": "^0.6.0",
    "@seneca/provider": "^5.0.0",
    "@types/jest": "^29.2.4",
    "@types/node": "^18.11.12",
    "esbuild": "^0.16.3",
    "esbuild-jest": "^0.5.0",
    "jest": "^29.3.1",
    "seneca": "^4.0.0",
    "seneca-msg-test": "^5.0.0",
    "typescript": "^4.9.4"
  }
}
